# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for real answers.
# With no ANTHROPIC_API_KEY the app runs in fake mode: offline test web, deterministic model.

# --- Keys
ANTHROPIC_API_KEY=           # required for real answers (https://console.anthropic.com)
TAVILY_API_KEY=              # optional; faster search with dates (https://tavily.com). Without it, search uses Anthropic's web_search tool.

# --- Search
SEARCH_PROVIDER=auto         # auto (tavily if TAVILY_API_KEY, else anthropic) | tavily | anthropic
SEARCH_MODEL=claude-haiku-5-5  # model that runs Anthropic's web_search tool when SEARCH_PROVIDER=anthropic

# --- Models
ANSWER_MODEL=claude-opus-5-5 # writes the answers you read (streamed)
FAST_MODEL=claude-haiku-5-5  # routing, fact extraction, re-checks
ANSWER_EFFORT=medium         # low | medium | high for web answers (small talk and recall always use low)
FAST_OUTPUT=0                # 1 = fast output mode on the answer model (faster tokens, higher price)
MAX_SPEND_USD=               # optional hard cap on Anthropic spend per process; the live eval defaults to 5

# --- Time and memory
USER_TIMEZONE=Asia/Kolkata   # IANA zone used for "today", "last Tuesday", timestamps
MINIMI_NOW=                  # optional fixed "now" (ISO 8601, e.g. 2026-11-18T09:00:00+05:30) for demos
ALLOW_CLOCK_OVERRIDE=0       # 1 = demo clock in the UI and /time in the CLI (always on in fake mode)
DB_PATH=data/minimi.db       # SQLite file with sessions, messages, searches and facts

# --- Watchlist ("right moment" nudges)
WATCH_ENABLED=1              # 0 = never re-check in the background, never nudge
WATCH_AFTER_DAYS=3           # re-check a tracked fact only when it is at least this old
WATCH_MAX_SEARCHES=3         # at most this many searches per new-chat check

# --- Server
PORT=3000
HOST=127.0.0.1
FAKE_MODE=0                  # 1 = force fake mode even with keys
