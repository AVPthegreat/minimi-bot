# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for real answers.
# With no ANTHROPIC_API_KEY the app runs in fake mode: offline test web, deterministic model.

# --- Keys
# required for real answers (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# optional; faster search with dates (https://tavily.com). Without it, search uses Anthropic's web_search tool.
TAVILY_API_KEY=

# --- Search
# auto (tavily if TAVILY_API_KEY, else anthropic) | tavily | anthropic
SEARCH_PROVIDER=auto
# model that runs Anthropic's web_search tool when SEARCH_PROVIDER=anthropic
SEARCH_MODEL=claude-haiku-5-5

# --- Models
# writes the answers you read (streamed)
ANSWER_MODEL=claude-opus-5-5
# routing, fact extraction, re-checks
FAST_MODEL=claude-haiku-5-5
# low | medium | high for web answers (small talk and recall always use low)
ANSWER_EFFORT=medium
# Web searches the answer model may run itself when the prefetched sources fall short (0-5)
ANSWER_MAX_SEARCHES=3
# 1 = fast output mode on the answer model (faster tokens, higher price)
FAST_OUTPUT=0
# optional hard cap on Anthropic spend per process; the live eval defaults to 5
MAX_SPEND_USD=

# --- Time and memory
# IANA zone used for "today", "last Tuesday", timestamps
USER_TIMEZONE=Asia/Kolkata
# optional fixed "now" (ISO 8601, e.g. 2026-11-18T09:00:00+05:30) for demos
MINIMI_NOW=
# 1 = demo clock in the UI and /time in the CLI (always on in fake mode)
ALLOW_CLOCK_OVERRIDE=0
# SQLite file with sessions, messages, searches and facts
DB_PATH=data/minimi.db

# --- Watchlist ("right moment" nudges)
# 0 = never re-check in the background, never nudge
WATCH_ENABLED=1
# re-check a tracked fact only when it is at least this old
WATCH_AFTER_DAYS=3
# at most this many searches per new-chat check
WATCH_MAX_SEARCHES=3

# --- Server
PORT=3000
HOST=127.0.0.1
# 1 = force fake mode even with keys
FAKE_MODE=0

# Site logos in the UI: the server fetches each site's icon once (https, public hosts only, cached in data/logos).
# 0 = generated letter tiles only, no network.
LOGO_FETCH=1
