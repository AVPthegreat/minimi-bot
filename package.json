{
  "name": "minimi-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A chat agent with one tool (web search) that remembers what you asked and when, and re-checks its own past answers.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/server.ts",
    "chat": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "eval": "node --disable-warning=ExperimentalWarning --import tsx eval/run.ts",
    "eval:live": "EVAL_LIVE=1 node --disable-warning=ExperimentalWarning --import tsx eval/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
